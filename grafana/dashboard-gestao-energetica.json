    {
      "id": 14,
      "type": "timeseries",
      "title": "Consumo nas ultimas 24h (W) — comparacao",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket:\"energia-residencial\") |> range(start:-24h) |> filter(fn:(r)=>r._measurement==\"energia\" and r._field==\"watts\") |> aggregateWindow(every:5m, fn:mean, createEmpty:false) |> keep(columns:[\"_time\",\"_value\",\"circuito\"])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
